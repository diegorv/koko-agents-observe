{
  "name": "koko-agents-observe",
  "version": "1.3.0",
  "description": "Real-time observability dashboard for Claude Code agents",
  "license": "MIT",
  "repository": "https://github.com/diegorv/koko-agents-observe",
  "homepage": "https://github.com/diegorv/koko-agents-observe",
  "private": true,
  "scripts": {
    "start": "node start.mjs",
    "test": "npm run test:scripts && cd app/server && npm test && cd ../client && npm test",
    "test:scripts": "vitest run",
    "test:server:watch": "cd app/server && npm run test:watch",
    "test:client:watch": "cd app/client && npm run test:watch",
    "fmt": "npx --yes prettier@3.9.9 --write 'app/server/src/**/*.ts' 'app/client/src/**/*.{ts,tsx}' 'hooks/scripts/**/*.mjs' 'test/**/*.mjs' 'start.mjs'",
    "fmt:check": "npx --yes prettier@3.9.9 --check 'app/server/src/**/*.ts' 'app/client/src/**/*.{ts,tsx}' 'hooks/scripts/**/*.mjs' 'test/**/*.mjs' 'start.mjs'",
    "check": "npm test && npm run fmt"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "fsevents@2.3.3": true
  }
}
